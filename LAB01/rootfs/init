#!/bin/sh

# LAB 01 - Embedded Linux initialization

export PATH=/bin:/sbin:/usr/bin:/usr/sbin

echo "================================"
echo " Embedded Linux LAB 01"
echo " ARM Cortex-A9 | QEMU"
echo "================================"

mount -t proc none /proc
mount -t sysfs none /sys

echo "[LAB01] Initialization completed."

exec /sbin/init




